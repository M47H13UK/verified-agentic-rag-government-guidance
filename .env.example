# Copy this file to .env and fill it in. The .env file is git-ignored.

# One of these two is needed to run the agent.
# An API key bills per token. If it is set, it is used even when the token below is also set.
ANTHROPIC_API_KEY=
# A subscription token made with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# MongoDB. These are the defaults, so a local install needs no change.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=visa_guidance
