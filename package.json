{
  "name": "uk-visa-guidance-agent",
  "version": "0.1.0",
  "description": "Unofficial assistant that answers UK student and graduate visa questions from published guidance, with a quoted source for every claim.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:ping": "tsx scripts/db-ping.ts",
    "review": "tsx scripts/review.ts",
    "step": "tsx scripts/step.ts",
    "ingest:fetch": "tsx src/ingest/cli.ts fetch",
    "ingest:load": "tsx src/ingest/cli.ts load",
    "ingest": "npm run ingest:fetch && npm run ingest:load"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "marked": "^18.0.14"
  }
}
